# Telegram 机器人(找 @BotFather 创建, /newbot 获取 token)
TG_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# 你的 chat id(与机器人对话后访问 https://api.telegram.org/bot<token>/getUpdates 获取,
# 或直接给 @userinfobot 发任意消息)
TG_CHAT_ID=123456789
# Google AI Studio 申请的 Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# 可选: VPS 每轮巡检心跳(1=开启, 默认关闭)
RADAR_HEARTBEAT=0
# 可选: 每日 08:00 汇总心跳(1=开启, 默认开启)
RADAR_DAILY_HEARTBEAT=1
